# Copy to .env for local development. In production, set this in
# Vercel → Project → Settings → Environment Variables.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable analytics.
PUBLIC_GA4_ID=
# Google Ads tag (already the default in astro.config.mjs; set to empty to disable)
PUBLIC_GOOGLE_ADS_ID=AW-18508719198
PUBLIC_GOOGLE_ADS_FORM_LABEL=
PUBLIC_GOOGLE_ADS_CALL_LABEL=
