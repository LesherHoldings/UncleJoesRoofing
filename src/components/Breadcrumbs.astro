---
interface Props { items: { name: string; path: string }[]; light?: boolean }
const { items, light = false } = Astro.props;
const link = 'inline-block py-1 ' + (light ? 'underline decoration-white/40 underline-offset-2 hover:text-white' : 'underline decoration-line underline-offset-2 hover:text-navy');
---
<nav aria-label="Breadcrumb" class:list={['text-sm', light ? 'text-navy-mist' : 'text-muted']}>
  <ol class="flex flex-wrap items-center gap-1.5">
    <li><a href="/" class={link}>Home</a></li>
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        <span aria-hidden="true">/</span>
        {i === items.length - 1
          ? <span aria-current="page" class={light ? 'text-white' : 'text-navy'}>{item.name}</span>
          : <a href={item.path} class={link}>{item.name}</a>}
      </li>
    ))}
  </ol>
</nav>
