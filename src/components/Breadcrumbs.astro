---
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    <li><a href="/" class="underline decoration-line underline-offset-2 hover:text-ink">Home</a></li>
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        <span aria-hidden="true">/</span>
        {i === items.length - 1
          ? <span aria-current="page" class="text-ink">{item.name}</span>
          : <a href={item.path} class="underline decoration-line underline-offset-2 hover:text-ink">{item.name}</a>}
      </li>
    ))}
  </ol>
</nav>
