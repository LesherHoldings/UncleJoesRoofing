---
import Icon from './Icon.astro';
import { site } from '../config/site';
---
<ul class="flex flex-wrap gap-2" aria-label="Credentials">
  <li class="inline-flex items-center gap-1.5 rounded-full border-2 border-ink bg-white px-3 py-1 text-sm font-semibold text-ink">
    <Icon name="check" class="h-4 w-4" /> PA HIC Registered {site.hicNumber}
  </li>
  {site.credentials.map((c) => (
    <li class="inline-flex items-center gap-1.5 rounded-full border-2 border-dashed border-ink/50 bg-white px-3 py-1 text-sm font-semibold text-ink">
      <Icon name="check" class="h-4 w-4" /> {c}
    </li>
  ))}
</ul>
