---
import Icon from './Icon.astro';
import { site } from '../config/site';
---
<ul class="flex flex-wrap gap-2" aria-label="Credentials">
  <li class="inline-flex items-center gap-1.5 rounded-full border-2 border-navy bg-navy px-3 py-1 text-sm font-semibold text-white">
    <Icon name="shield" class="h-4 w-4 text-shutter" /> PA Registered Contractor {site.hicNumber}
  </li>
  {site.credentials.map((c) => (
    <li class="inline-flex items-center gap-1.5 rounded-full border-2 border-dashed border-navy/50 bg-white px-3 py-1 text-sm font-semibold text-navy">
      <Icon name="check" class="h-4 w-4" /> {c}
    </li>
  ))}
</ul>
