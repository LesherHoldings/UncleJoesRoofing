---
import CallButton from './CallButton.astro';
import { site, bookHref } from '../config/site';

interface Props {
  heading?: string;
  text?: string;
  location?: string;
}
const {
  heading = 'Got a roof question? Call your uncle.',
  text = "Book a free roof inspection, or just call and ask. We'll give you a straight answer.",
  location = 'cta_band',
} = Astro.props;
---
<section class="on-dark bg-shingles" data-motion>
  <div class="h-2 bg-shutter"></div>
  <div class="container-site flex flex-col gap-8 py-14 sm:py-16 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-2xl">
      <p class="font-display text-xl text-shutter">{site.tagline}</p>
      <h2 class="mt-1 text-3xl sm:text-4xl">{heading}</h2>
      <p class="mt-3 text-lg">{text}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
      <a href={bookHref} class="btn btn-yellow-dark text-lg">Book a Free Roof Inspection</a>
      <CallButton location={location} variant="outline-light" class="text-lg" />
    </div>
  </div>
</section>
