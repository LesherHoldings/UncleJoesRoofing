---
interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
}
const { faqs, heading = 'Common questions' } = Astro.props;
---
{faqs.length > 0 && (
  <section class="section" aria-labelledby="faq-heading">
    <div class="container-site max-w-3xl">
      <p class="kicker">FAQ</p>
      <h2 id="faq-heading" class="heading-lg">{heading}</h2>
      <div class="mt-8 divide-y divide-line border-y border-line">
        {faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-lg font-semibold text-ink [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <span aria-hidden="true" class="mt-0.5 flex h-7 w-7 flex-none items-center justify-center rounded-full border-2 border-ink bg-shutter text-lg leading-none transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 leading-relaxed text-ink-soft">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
