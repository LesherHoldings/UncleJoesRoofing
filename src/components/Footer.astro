---
import { Image } from 'astro:assets';
import icon from '../assets/brand/logo-icon.png';
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { site, telHref, footerServices, nearbyTowns, isPlaceholder } from '../config/site';
const hoursReady = !site.hours.some((h) => isPlaceholder(h.label));

const towns = (await getCollection('towns')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="on-dark bg-shingles bg-navy-deep pb-24 md:pb-0" data-motion>
  <div class="h-2 bg-shutter"></div>
  <div class="container-site grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-3">
        <span class="rounded-lg bg-white p-2"><Image src={icon} alt="" width={40} widths={[40, 80]} sizes="40px" class="h-auto w-10" loading="lazy" /></span>
        <p class="font-display text-2xl font-bold text-white">{site.name}</p>
      </div>
      <p class="mt-3 font-display text-xl text-shutter">{site.tagline}</p>
      <address class="mt-5 space-y-1 not-italic">
        <a href={telHref} data-call-location="footer" data-phone-number={site.phone.display} class="inline-flex items-center gap-2 text-lg font-semibold text-white underline decoration-shutter decoration-2 underline-offset-4"><Icon name="phone" class="h-5 w-5" />{site.phone.display}</a>
        {site.address.street && <span class="block">{site.address.street}</span>}
        <span class="block">Based in {site.address.city}, {site.address.region} {site.address.postalCode}</span>
      </address>
      <p class="mt-5 max-w-xs text-sm">Veteran-owned and owner-led. Roofing only. We come to you across Montgomery &amp; Chester County.</p>
    </div>

    <div>
      <h2 class="font-sans text-sm font-bold tracking-[0.15em] text-shutter uppercase">Services</h2>
      <ul class="mt-3 space-y-0.5">
        {footerServices.map((s) => <li><a href={s.href} class="inline-block py-1 hover:text-white hover:underline">{s.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="font-sans text-sm font-bold tracking-[0.15em] text-shutter uppercase">Service Areas</h2>
      <ul class="mt-3 space-y-0.5">
        {towns.map((t) => <li><a href={`/service-areas/${t.id}/`} class="inline-block py-1 hover:text-white hover:underline">{t.data.name}, PA</a></li>)}
        <li><a href="/service-areas/" class="inline-block py-1 hover:text-white hover:underline">All areas</a></li>
      </ul>
      <p class="mt-4 text-xs leading-relaxed">Also {nearbyTowns.slice(0, 5).join(', ')} and nearby.</p>
    </div>

    <div>
      <h2 class="font-sans text-sm font-bold tracking-[0.15em] text-shutter uppercase">Company</h2>
      <ul class="mt-3 space-y-0.5">
        <li><a href="/our-story/" class="inline-block py-1 hover:text-white hover:underline">Our Story</a></li>
        <li><a href="/contact/" class="inline-block py-1 hover:text-white hover:underline">Contact</a></li>
        <li><a href="/privacy/" class="inline-block py-1 hover:text-white hover:underline">Privacy Policy</a></li>
        <li><a href="/terms/" class="inline-block py-1 hover:text-white hover:underline">Terms &amp; Conditions</a></li>
      </ul>
      {hoursReady && (
        <>
          <h2 class="mt-6 font-sans text-sm font-bold tracking-[0.15em] text-shutter uppercase">Hours</h2>
          <ul class="mt-3 space-y-1 text-sm">
            {site.hours.map((h) => <li><span class="text-white">{h.days}:</span> {h.label}</li>)}
          </ul>
        </>
      )}
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="container-site flex flex-col gap-2 py-6 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p><strong class="text-white">PA Home Improvement Contractor Registration: {site.hicNumber}</strong></p>
      <p>&copy; {year} {site.name}. {site.dbaLine}</p>
    </div>
  </div>
</footer>
