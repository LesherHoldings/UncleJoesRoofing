---
import { Image } from 'astro:assets';
import icon from '../assets/brand/logo-icon.png';
import { getCollection } from 'astro:content';
import { site, telHref, nav } from '../config/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const towns = (await getCollection('towns')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="bg-ink pb-24 text-neutral-300 md:pb-0">
  <div class="h-1.5 bg-shutter"></div>
  <div class="container-site grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="flex items-center gap-3">
        <span class="rounded-lg bg-white p-2"><Image src={icon} alt="" width={40} widths={[40, 80]} sizes="40px" class="h-auto w-10" loading="lazy" /></span>
        <p class="font-display text-2xl font-bold text-white">{site.name}</p>
      </div>
      <p class="mt-3 font-display text-xl text-shutter">{site.tagline}</p>
      <address class="mt-5 space-y-1 not-italic">
        <a href={telHref} data-call-location="footer" class="block text-lg font-semibold text-white underline decoration-shutter decoration-2 underline-offset-4">{site.phone.display}</a>
        <span class="block">{site.address.street}</span>
        <span class="block">{site.address.city}, {site.address.region} {site.address.postalCode}</span>
      </address>
    </div>

    <div>
      <h2 class="font-sans text-sm font-bold tracking-[0.15em] text-white uppercase">Services</h2>
      <ul class="mt-4 space-y-2">
        <li><a href="/book/" class="hover:text-white">Book an Inspection</a></li>
        {services.map((s) => <li><a href={`/${s.id}/`} class="hover:text-white">{s.data.cardTitle}</a></li>)}
        <li><a href="/financing/" class="hover:text-white">Financing</a></li>
      </ul>
    </div>

    <div>
      <h2 class="font-sans text-sm font-bold tracking-[0.15em] text-white uppercase">Service Areas</h2>
      <ul class="mt-4 space-y-2">
        {towns.map((t) => <li><a href={`/service-areas/${t.id}/`} class="hover:text-white">{t.data.name}, PA</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="font-sans text-sm font-bold tracking-[0.15em] text-white uppercase">Company</h2>
      <ul class="mt-4 space-y-2">
        {nav.filter((n) => ['/our-story/', '/contact/'].includes(n.href)).map((n) => <li><a href={n.href} class="hover:text-white">{n.label}</a></li>)}
        <li><a href="/privacy/" class="hover:text-white">Privacy Policy</a></li>
        <li><a href="/terms/" class="hover:text-white">Terms &amp; Conditions</a></li>
      </ul>
      <h2 class="mt-6 font-sans text-sm font-bold tracking-[0.15em] text-white uppercase">Hours</h2>
      <ul class="mt-3 space-y-1 text-sm">
        {site.hours.map((h) => <li><span class="text-white">{h.days}:</span> {h.label}</li>)}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="container-site flex flex-col gap-2 py-6 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p>
        <strong class="text-white">PA Home Improvement Contractor Registration: {site.hicNumber}</strong>
      </p>
      <p>&copy; {year} {site.name}. {site.dbaLine}</p>
    </div>
  </div>
</footer>
