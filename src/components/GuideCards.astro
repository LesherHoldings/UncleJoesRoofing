---
/** Two "plain-talk guide" cards linking to Pricing & Warranties and What to Expect. */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { photo } from '../lib/photos';

interface Props { exclude?: 'pricing' | 'expect' }
const { exclude } = Astro.props;
const guides = [
  { key: 'pricing', href: '/pricing-and-warranties/', icon: 'dollar', title: 'How pricing & warranties work', text: 'What goes into a roof quote, the three kinds of shingles, and the difference between a manufacturer warranty and a workmanship warranty.', image: 'shingle-samples', alt: 'Asphalt shingle samples laid out on a workbench' },
  { key: 'expect', href: '/what-to-expect/', icon: 'calendar', title: 'What to expect on install day', text: 'How to get ready, what happens hour by hour, how we clean up, and what to do if your roof is leaking right now.', image: 'install-day', alt: 'Roofing crew installing new shingles on a two-story home' },
].filter((g) => g.key !== exclude) as { key: string; href: string; icon: 'dollar' | 'calendar'; title: string; text: string; image: string; alt: string }[];
---
<ul class:list={['grid gap-5', guides.length > 1 && 'md:grid-cols-2']}>
  {guides.map((g) => {
    const img = photo(g.image);
    return (
      <li class="card-lift relative flex overflow-hidden rounded-xl border-2 border-line bg-white">
        {img && <Image src={img} alt={g.alt} widths={[320, 640]} sizes="(min-width: 768px) 30vw, 35vw" class="hidden w-2/5 object-cover sm:block" loading="lazy" />}
        <div class="flex flex-1 flex-col p-6">
          <span class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg border-2 border-navy bg-shutter text-navy"><Icon name={g.icon} class="h-5 w-5" /></span>
          <h3 class="text-2xl"><a href={g.href} class="no-underline after:absolute after:inset-0 after:content-['']">{g.title}</a></h3>
          <p class="mt-2 flex-1 text-ink-soft">{g.text}</p>
          <span class="mt-4 inline-flex items-center gap-1.5 font-semibold text-navy underline decoration-navy decoration-2 underline-offset-4" aria-hidden="true">Read the guide <Icon name="arrow" class="h-4 w-4" /></span>
        </div>
      </li>
    );
  })}
</ul>
