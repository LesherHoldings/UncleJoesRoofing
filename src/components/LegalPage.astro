---
/** Shared template for /privacy/ and /terms/ — markdown body plus contact details from site config. */
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import { site, telHref } from '../config/site';

interface Props { id: 'privacy' | 'terms'; path: string; label: string }
const { id, path, label } = Astro.props;
const page = (await getEntry('pages', id))!;
const { Content } = await render(page);
const d = page.data;
const crumbs = [{ name: label, path }];
---
<Layout title={d.title} description={d.description} ogImage={d.ogImage} breadcrumbs={crumbs}>
  <PageHero h1={d.h1} intro={d.lastUpdated && `Last updated: ${d.lastUpdated}`} breadcrumbs={crumbs} ctas={false} />
  <section class="section">
    <div class="container-site max-w-3xl">
      <div class="prose prose-lg prose-site max-w-none">
        <Content />
        <h2>Contact us</h2>
      </div>
      <address class="mt-4 rounded-xl border-2 border-line bg-navy-mist p-6 not-italic text-ink-soft">
        <strong class="block font-display text-xl text-navy">{site.name}</strong>
        <span class="block">A DBA of {site.legalName}</span>
        <span class="block">{site.address.street}</span>
        <span class="block">{site.address.city}, {site.address.region} {site.address.postalCode}</span>
        <span class="mt-3 block">Phone: <a href={telHref} data-call-location={`${id}_page`} class="link">{site.phone.display}</a></span>
        {!site.email.includes('PENDING') && <span class="block">Email: <a href={`mailto:${site.email}`} class="link">{site.email}</a></span>}
        <span class="mt-3 block text-sm text-muted">PA Home Improvement Contractor Registration: {site.hicNumber}</span>
      </address>
    </div>
  </section>
</Layout>
