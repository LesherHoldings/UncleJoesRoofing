---
/** "Meet the owner" — name, photo, bio and facts come from src/config/site.ts → owner. */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Checklist from './Checklist.astro';
import { owner, site } from '../config/site';
import { photo } from '../lib/photos';

const img = photo(owner.photo);
---
<section class="section" aria-labelledby="owner-heading">
  <div class="container-site grid items-center gap-10 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
    <figure class="mx-auto w-full max-w-xs lg:max-w-none">
      <div class="relative">
        <span aria-hidden="true" class="absolute -top-3 -left-3 h-full w-full rounded-2xl bg-shutter"></span>
        {img ? (
          <Image src={img} alt={owner.photoAlt} widths={[400, 800]} sizes="(min-width: 1024px) 352px, 320px" class="relative aspect-[4/5] w-full rounded-2xl border-2 border-navy object-cover" loading="lazy" />
        ) : (
          <div class="relative flex aspect-[4/5] w-full flex-col items-center justify-center gap-3 rounded-2xl border-2 border-navy bg-navy text-white" aria-hidden="true">
            <Icon name="anchor" class="h-14 w-14 text-shutter" />
            <span class="text-xs font-bold tracking-[0.2em] uppercase">Photo coming soon</span>
          </div>
        )}
      </div>
      <figcaption class="mt-5">
        <span class="block font-display text-2xl font-bold text-navy">{owner.name}</span>
        <span class="block text-sm font-semibold tracking-wide text-navy-text uppercase">{owner.role}</span>
      </figcaption>
    </figure>
    <div>
      <p class="kicker">Meet the owner</p>
      <h2 id="owner-heading" class="heading-lg">The uncle you're calling</h2>
      <div class="relative mt-5 border-l-4 border-shutter pl-5">
        {owner.blurb.map((p) => <p class="mt-3 text-lg leading-relaxed text-ink-soft first:mt-0">{p}</p>)}
      </div>
      <p class="mt-5 text-ink-soft">
        "Owner-led" isn't a slogan here. The same person who inspects your roof writes the quote, is on site when the crew shows up, and walks the finished job with you. No hand-off to a salesperson. No call center.
      </p>
      <Checklist class="mt-6" items={[
        ...owner.facts,
        `PA registered home improvement contractor ${site.hicNumber}`,
        `Office in ${site.address.city}, PA`,
      ]} />
    </div>
  </div>
</section>
