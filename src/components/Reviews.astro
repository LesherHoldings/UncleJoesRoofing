---
import { site } from '../config/site';

interface Props { heading?: string; text?: string }
const { heading = 'What our neighbors say', text } = Astro.props;
const reviews = site.reviews;
---
<section class="section bg-paper" aria-labelledby="reviews-heading">
  <div class="container-site">
    <p class="kicker">Reviews</p>
    <h2 id="reviews-heading" class="heading-lg">{heading}</h2>
    {text && <p class="mt-3 max-w-2xl text-lg text-ink-soft">{text}</p>}
    <ul class="mt-8 grid gap-5 md:grid-cols-3">
      {reviews.map((r) => (
        <li>
          <figure class:list={['h-full rounded-xl border-2 bg-white p-6', r.verified ? 'border-line' : 'border-dashed border-ink/40']}>
            <blockquote class="text-lg leading-relaxed text-ink">“{r.quote}”</blockquote>
            <figcaption class="mt-4 text-sm text-muted">
              <span class="font-semibold text-ink">{r.name}</span> · {r.town}{r.service && <> · {r.service}</>}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    {site.reviewsUrl && (
      <a href={site.reviewsUrl} class="btn btn-outline mt-8" rel="noopener" target="_blank">Read our Google reviews</a>
    )}
  </div>
</section>
