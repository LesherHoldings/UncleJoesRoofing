---
/**
 * The "Uncle Joe house" shutters: yellow board shutters with white anchors cut into them,
 * flanking a window. Pure SVG, so it costs almost nothing to load.
 */
interface Props { class?: string }
const { class: className = '' } = Astro.props;

// One anchor "cut-out", drawn in white, centered at (0,0), about 60 units tall.
const anchor = `
  <circle cx="0" cy="-26" r="5" fill="none" stroke="#fff" stroke-width="4"/>
  <path d="M0 -21 V26" stroke="#fff" stroke-width="5" stroke-linecap="round"/>
  <path d="M-12 -11 H12" stroke="#fff" stroke-width="5" stroke-linecap="round"/>
  <path d="M-20 8 C-18 20 -9 26 0 28 C9 26 18 20 20 8" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round"/>
  <path d="M-24 13 L-20 5 L-14 11 M24 13 L20 5 L14 11" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
`;
---
<svg class={className} viewBox="0 0 420 360" role="img" aria-labelledby="shutter-title">
  <title id="shutter-title">Yellow shutters with white anchors cut into them, like the original Uncle Joe house</title>
  <!-- siding -->
  <rect width="420" height="360" fill="#f8f6f1" />
  <g stroke="#e6e3dc" stroke-width="2">
    <path d="M0 30H420M0 60H420M0 90H420M0 120H420M0 150H420M0 180H420M0 210H420M0 240H420M0 270H420M0 300H420M0 330H420" />
  </g>
  <!-- window -->
  <rect x="140" y="50" width="140" height="240" rx="3" fill="#111" />
  <rect x="150" y="60" width="120" height="220" fill="#cfe2ef" />
  <path d="M210 60V280M150 170H270" stroke="#fff" stroke-width="8" />
  <rect x="130" y="286" width="160" height="14" rx="2" fill="#fff" stroke="#111" stroke-width="3" />
  <!-- shutters -->
  {[42, 290].map((x) => (
    <g transform={`translate(${x} 46)`}>
      <rect width="88" height="248" rx="3" fill="#F2C230" stroke="#111" stroke-width="4" />
      <path d="M22 4V244M44 4V244M66 4V244" stroke="#d9a914" stroke-width="2" />
      <rect x="6" y="40" width="76" height="10" fill="#d9a914" opacity=".6" />
      <rect x="6" y="198" width="76" height="10" fill="#d9a914" opacity=".6" />
      <g transform="translate(44 124)" set:html={anchor} />
    </g>
  ))}
</svg>
