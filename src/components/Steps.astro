---
/** Numbered "how it works" steps. Data comes from a service's `steps` front matter. */
interface Props { steps: { title: string; text: string }[]; class?: string }
const { steps, class: className = '' } = Astro.props;
---
<ol class:list={['grid gap-5 sm:grid-cols-2', className]}>
  {steps.map((s, i) => (
    <li class="flex gap-4">
      <span class="flex h-10 w-10 flex-none items-center justify-center rounded-lg border-2 border-navy bg-shutter font-display text-lg font-bold text-navy">{i + 1}</span>
      <div><h3 class="text-xl">{s.title}</h3><p class="mt-1 text-ink-soft">{s.text}</p></div>
    </li>
  ))}
</ol>
