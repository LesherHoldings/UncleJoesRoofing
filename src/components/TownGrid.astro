---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

interface Props { exclude?: string; compact?: boolean }
const { exclude, compact = false } = Astro.props;
const towns = (await getCollection('towns')).filter((t) => t.id !== exclude).sort((a, b) => a.data.order - b.data.order);
---
<ul class:list={['grid gap-4', compact ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2 lg:grid-cols-4']}>
  {towns.map((t) => (
    <li class="relative rounded-xl border-2 border-line bg-white p-5 transition hover:border-ink">
      <div class="flex items-start gap-3">
        <Icon name="pin" class="mt-1 h-5 w-5 flex-none text-ink" />
        <div>
          <h3 class="text-xl">
            <a href={`/service-areas/${t.id}/`} class="no-underline after:absolute after:inset-0 after:content-['']">{t.data.name}, PA</a>
          </h3>
          {!compact && <p class="mt-1 text-ink-soft">{t.data.summary}</p>}
        </div>
      </div>
    </li>
  ))}
</ul>
