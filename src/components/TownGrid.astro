---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { photo } from '../lib/photos';

interface Props { exclude?: string; compact?: boolean }
const { exclude, compact = false } = Astro.props;
const towns = (await getCollection('towns')).filter((t) => t.id !== exclude).sort((a, b) => a.data.order - b.data.order);
---
<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {towns.map((t) => {
    const img = photo(t.data.image);
    return (
      <li class="card-lift relative overflow-hidden rounded-xl border-2 border-line bg-white">
        {!compact && img && (
          <Image src={img} alt={t.data.imageAlt ?? ''} widths={[400, 800]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" class="aspect-[3/2] w-full object-cover" loading="lazy" />
        )}
        <div class="flex items-start gap-3 p-5">
          <Icon name="pin" class="mt-1 h-5 w-5 flex-none text-shutter-dark" />
          <div>
            <h3 class="text-xl">
              <a href={`/service-areas/${t.id}/`} class="no-underline after:absolute after:inset-0 after:content-['']">{t.data.name}, PA</a>
            </h3>
            {!compact && <p class="mt-1 text-ink-soft">{t.data.summary}</p>}
          </div>
        </div>
      </li>
    );
  })}
</ul>
