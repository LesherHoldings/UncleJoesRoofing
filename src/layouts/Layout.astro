---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import LandingHeader from '../components/LandingHeader.astro';
import LandingFooter from '../components/LandingFooter.astro';
import Analytics from '../components/Analytics.astro';
import { site } from '../config/site';
import { pageGraph, type PageType } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Breadcrumb trail after "Home". Omit on the home page. */
  breadcrumbs?: { name: string; path: string }[];
  /** Extra JSON-LD nodes for this page's @graph (a Service, for example). */
  schema?: object[];
  /** schema.org page type; defaults to WebPage. */
  pageType?: PageType;
  /** FAQs shown on the page — also marks the page as an FAQPage. */
  faqs?: { q: string; a: string }[];
  /** @id of the node this page is mainly about (e.g. its Service). */
  mainEntityId?: string;
  noindex?: boolean;
  /** Full robots directive, e.g. "noindex, nofollow" (overrides noindex). */
  robots?: string;
  /** 'landing' = ads landing page: logo + phone header, slim footer, call bar points at #quote. */
  variant?: 'default' | 'landing';
}

const { title, description, ogImage = '/og/default.png', breadcrumbs, schema = [], pageType, faqs, mainEntityId, noindex = false, robots, variant = 'default' } = Astro.props;
const robotsContent = robots ?? (noindex ? 'noindex' : '');
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogUrl = new URL(ogImage, site.url).href;

const jsonLd = pageGraph({ path: Astro.url.pathname, title, description, ogImage, type: pageType, faqs, breadcrumbs, mainEntityId, extra: schema });
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robotsContent && <meta name="robots" content={robotsContent} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f2a4a" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Lets CSS know JS is available (the scroll-reveal only hides content when it can reveal it) -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only z-50 rounded bg-white px-4 py-2 text-navy focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to content</a>
    {variant === 'landing' ? <LandingHeader /> : <Header />}
    <main id="main" class="flex-1 outline-none" tabindex="-1">
      <slot />
    </main>
    {variant === 'landing' ? <LandingFooter /> : <Footer />}
    <MobileCallBar />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
