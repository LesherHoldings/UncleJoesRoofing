---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import Analytics from '../components/Analytics.astro';
import { site } from '../config/site';
import { businessSchema, breadcrumbSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Breadcrumb trail after "Home". Omit on the home page. */
  breadcrumbs?: { name: string; path: string }[];
  /** Extra JSON-LD objects for this page (Service, FAQPage, ...) */
  schema?: object[];
  noindex?: boolean;
}

const { title, description, ogImage = '/og/default.png', breadcrumbs, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogUrl = new URL(ogImage, site.url).href;

const jsonLd = [businessSchema(), ...schema];
if (breadcrumbs?.length) {
  jsonLd.push(breadcrumbSchema([{ name: 'Home', path: '/' }, ...breadcrumbs]));
}
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f2a4a" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Lets CSS know JS is available (the scroll-reveal only hides content when it can reveal it) -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only z-50 rounded bg-white px-4 py-2 text-navy focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
