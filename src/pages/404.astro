---
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
---
<Layout title="Page Not Found | Uncle Joe's Roofing" description="That page doesn't exist. Head back home or call your uncle." noindex>
  <section class="section">
    <div class="container-site max-w-2xl text-center">
      <p class="kicker">404</p>
      <h1 class="heading-lg">We couldn't find that page.</h1>
      <p class="mt-4 text-lg text-ink-soft">It may have moved. Try the home page — or just call your uncle.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">Go to the home page</a>
        <CallButton location="404" variant="outline" />
      </div>
    </div>
  </section>
</Layout>
