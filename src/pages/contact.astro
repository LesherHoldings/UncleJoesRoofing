---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import GhlForm from '../components/GhlForm.astro';
import Icon from '../components/Icon.astro';
import { site, telHref, fullAddress } from '../config/site';

const page = (await getEntry('pages', 'contact'))!;
const d = page.data;
const crumbs = [{ name: 'Contact', path: '/contact/' }];
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.name}, ${fullAddress}`)}`;
---
<Layout title={d.title} description={d.description} ogImage={d.ogImage} breadcrumbs={crumbs}>
  <PageHero h1={d.h1} intro={d.intro} kicker={site.tagline} breadcrumbs={crumbs} image={d.image} imageAlt={d.imageAlt} ctas={false} />
  <section class="section">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_minmax(0,30rem)]">
      <div class="space-y-8">
        <a href={telHref} data-call-location="contact_page" class="group flex items-center gap-4 rounded-xl border-2 border-navy bg-shutter p-5 text-navy no-underline shadow-sign">
          <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-navy text-shutter"><Icon name="phone" class="h-6 w-6" /></span>
          <span>
            <span class="block text-sm font-bold tracking-[0.15em] uppercase">Call your uncle</span>
            <span class="block font-display text-2xl font-bold sm:text-3xl">{site.phone.display}</span>
          </span>
        </a>
        <dl class="space-y-6">
          <div class="flex gap-4">
            <dt><Icon name="pin" class="h-6 w-6 text-navy" label="Address" /></dt>
            <dd>
              <address class="not-italic text-ink-soft">{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}</address>
              <a href={directions} class="link mt-1 inline-block" rel="noopener" target="_blank">Get directions <span class="sr-only">(opens in a new tab)</span></a>
            </dd>
          </div>
          {!site.email.includes('PENDING') && (
            <div class="flex gap-4">
              <dt><Icon name="mail" class="h-6 w-6 text-navy" label="Email" /></dt>
              <dd><a href={`mailto:${site.email}`} class="link">{site.email}</a></dd>
            </div>
          )}
          <div class="flex gap-4">
            <dt><Icon name="clock" class="h-6 w-6 text-navy" label="Hours" /></dt>
            <dd>
              <ul class="space-y-1 text-ink-soft">
                {site.hours.map((h) => <li><span class="font-semibold">{h.days}:</span> {h.label}</li>)}
              </ul>
            </dd>
          </div>
        </dl>
        <div class="rounded-xl border-2 border-line bg-white p-6">
          <h2 class="text-2xl">What happens when you call</h2>
          <p class="mt-2 text-ink-soft">
            You'll talk to a person, not a phone tree. We'll ask a few questions about your roof, set a time for a free inspection, and show up when we said we would. After the visit you get photos of what we found and a written quote if you need work. No pressure, and no "sign today" pricing. Here's <a href="/what-to-expect/" class="link">what to expect</a> if you go ahead.
          </p>
        </div>
        <div class="rounded-xl border-2 border-line bg-navy-mist p-6">
          <h2 class="text-2xl">Where we work</h2>
          <p class="mt-2 text-ink-soft">
            Conshohocken, Blue Bell, Malvern, Paoli and nearby towns like King of Prussia, Plymouth Meeting, Wayne and Berwyn. <a href="/service-areas/" class="link">See all service areas</a>.
          </p>
        </div>
      </div>
      <div id="request" class="scroll-mt-24">
        <GhlForm heading="Send us a message" text="We'll get back to you, usually by phone." />
      </div>
    </div>
  </section>
</Layout>
