---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import CallButton from '../components/CallButton.astro';
import GuideCards from '../components/GuideCards.astro';
import { site, bookHref, isPlaceholder } from '../config/site';
const partner = isPlaceholder(site.financing.partner) ? '' : site.financing.partner;

const page = (await getEntry('pages', 'financing'))!;
const { Content } = await render(page);
const d = page.data;
const crumbs = [{ name: 'Financing', path: '/financing/' }];
---
<Layout title={d.title} description={d.description} ogImage={d.ogImage} breadcrumbs={crumbs} faqs={d.faqs}>
  <PageHero h1={d.h1} intro={d.intro} kicker="Financing" breadcrumbs={crumbs} image={d.image} imageAlt={d.imageAlt} location="financing_hero" />
  <section class="section">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_22rem]">
      <div class="prose prose-lg prose-site max-w-none">
        <Content />
      </div>
      <aside class="self-start rounded-xl border-2 border-navy bg-white p-6 shadow-sign lg:sticky lg:top-28">
        <p class="kicker">Financing</p>
        {partner ? <p class="mt-2 font-display text-2xl text-navy">{partner}</p> : <p class="mt-2 font-display text-2xl text-navy">Ask us about options</p>}
        <p class="mt-3 text-sm text-ink-soft">All financing is subject to credit approval. Rates and terms are set by the lender.</p>
        <div class="mt-5 flex flex-col gap-3">
          {site.financing.applyUrl && <a href={site.financing.applyUrl} class="btn btn-primary" rel="noopener" target="_blank">Apply with our partner</a>}
          <a href={bookHref} class:list={['btn', site.financing.applyUrl ? 'btn-outline' : 'btn-primary']}>Book a free inspection</a>
          <CallButton location="financing_sidebar" variant="dark" />
        </div>
      </aside>
    </div>
  </section>
  <Faq faqs={d.faqs} heading="Financing questions" />
  <section class="section border-t border-line bg-paper"><div class="container-site"><h2 class="heading-lg">Know what you're buying</h2><div class="mt-8"><GuideCards /></div></div></section>
  <CtaBand location="financing_cta" />
</Layout>
