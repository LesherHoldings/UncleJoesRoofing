---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import CallButton from '../components/CallButton.astro';
import { site, bookHref } from '../config/site';
import { faqSchema } from '../lib/schema';

const page = (await getEntry('pages', 'financing'))!;
const { Content } = await render(page);
const d = page.data;
const crumbs = [{ name: 'Financing', path: '/financing/' }];
---
<Layout title={d.title} description={d.description} ogImage={d.ogImage} breadcrumbs={crumbs} schema={d.faqs.length ? [faqSchema(d.faqs)] : []}>
  <PageHero h1={d.h1} intro={d.intro} kicker="Financing" breadcrumbs={crumbs} location="financing_hero" />
  <section class="section">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_22rem]">
      <div class="prose prose-lg prose-site max-w-none">
        <Content />
      </div>
      <aside class="self-start rounded-xl border-2 border-ink bg-white p-6 shadow-[6px_6px_0_0_#111]">
        <p class="text-sm font-bold tracking-[0.15em] text-muted uppercase">Financing partner</p>
        <p class="mt-2 font-display text-2xl text-ink">{site.financing.partner}</p>
        <p class="mt-3 text-sm text-ink-soft">All financing is subject to credit approval. Rates and terms are set by the lender.</p>
        <div class="mt-5 flex flex-col gap-3">
          {site.financing.applyUrl && <a href={site.financing.applyUrl} class="btn btn-primary" rel="noopener" target="_blank">Apply with our partner</a>}
          <a href={bookHref} class:list={['btn', site.financing.applyUrl ? 'btn-outline' : 'btn-primary']}>Book a free inspection</a>
          <CallButton location="financing_sidebar" variant="dark" />
        </div>
      </aside>
    </div>
  </section>
  <Faq faqs={d.faqs} heading="Financing questions" />
  <CtaBand location="financing_cta" />
</Layout>
