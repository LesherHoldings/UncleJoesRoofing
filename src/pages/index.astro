---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
import ServiceCards from '../components/ServiceCards.astro';
import TownGrid from '../components/TownGrid.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import Credentials from '../components/Credentials.astro';
import Gallery from '../components/Gallery.astro';
import MeetOwner from '../components/MeetOwner.astro';
import EmergencyLeak from '../components/EmergencyLeak.astro';
import GuideCards from '../components/GuideCards.astro';
import Icon from '../components/Icon.astro';
import { site, bookHref } from '../config/site';
import { photo } from '../lib/photos';

const page = (await getEntry('pages', 'home'))!;
const { hero, whyUs, storyTeaser, serviceArea, reviews, finalCta } = page.data;
const heroImg = photo(page.data.image);
const shutters = photo('shutter-detail');
---
<Layout title={page.data.title} description={page.data.description} ogImage={page.data.ogImage}>
  <!-- Hero: full-bleed photo, navy overlay, slow sunlight glow and shore waves -->
  <section class="on-dark bg-glow relative isolate overflow-hidden bg-navy" data-motion>
    {heroImg && (
      <Image src={heroImg} alt={page.data.imageAlt ?? ''} widths={[640, 960, 1280, 1920]} sizes="100vw" class="absolute inset-0 -z-20 h-full w-full object-cover object-[70%_center]" loading="eager" fetchpriority="high" />
    )}
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-deep via-navy/90 to-navy/30" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-navy-deep/80 to-transparent" aria-hidden="true"></div>

    <div class="container-site relative py-16 pb-24 sm:py-20 sm:pb-28 lg:py-28 lg:pb-36">
      <div class="max-w-2xl">
        <p class="kicker">Roofing in Conshohocken, Blue Bell, Malvern &amp; Paoli, PA</p>
        <h1 class="heading-xl text-white">
          <span class="underline-sign">{page.data.h1}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed sm:text-xl">{hero?.subheading}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={bookHref} class="btn btn-yellow-dark text-lg">Book a Free Roof Inspection</a>
          <CallButton location="home_hero" variant="outline-light" class="text-lg" />
        </div>
        <ul class="mt-8 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:gap-x-6">
          {hero?.points.map((p) => (
            <li class="flex items-center gap-2 font-medium text-white"><Icon name="check" class="h-5 w-5 text-shutter" />{p}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="waves" aria-hidden="true">
      <svg viewBox="0 0 2880 56" preserveAspectRatio="none"><path fill="#ffffff" d="M0 30c120 0 180-18 360-18s240 24 360 24 180-18 360-18 240 24 360 24 180-18 360-18 240 24 360 24 180-18 360-18 240 24 360 24V56H0z" /></svg>
      <svg viewBox="0 0 2880 56" preserveAspectRatio="none"><path fill="#ffffff" d="M0 40c160 0 200-22 360-22s200 22 360 22 200-22 360-22 200 22 360 22 200-22 360-22 200 22 360 22 200-22 360-22 200 22 360 22V56H0z" /></svg>
    </div>
  </section>

  <!-- Trust strip -->
  <div class="border-b border-line bg-white">
    <ul class="container-site flex flex-wrap items-center justify-center gap-x-8 gap-y-2 py-4 text-sm font-semibold text-navy">
      <li class="flex items-center gap-2"><Icon name="shield" class="h-5 w-5 text-shutter-dark" /> PA Registered Contractor {site.hicNumber}</li>
      <li class="flex items-center gap-2"><Icon name="pin" class="h-5 w-5 text-shutter-dark" /> Office in {site.address.city}, PA</li>
      <li class="flex items-center gap-2"><Icon name="check" class="h-5 w-5 text-shutter-dark" /> Owner-led, roofing only</li>
      <li class="flex items-center gap-2"><Icon name="inspect" class="h-5 w-5 text-shutter-dark" /> Free inspections with photos</li>
    </ul>
  </div>

  <!-- Services -->
  <section class="section" aria-labelledby="services-heading">
    <div class="container-site">
      <div class="reveal">
        <p class="kicker">What we do</p>
        <h2 id="services-heading" class="heading-lg">Roofing, and only roofing</h2>
        <p class="mt-3 max-w-2xl text-lg text-ink-soft">We focus on one thing and do it well. Need solar down the road? Ask about a <a href="/solar-ready-roofs/" class="link">solar-ready roof</a>.</p>
      </div>
      <div class="reveal mt-10"><ServiceCards onlyHome /></div>
    </div>
  </section>

  <EmergencyLeak />

  <!-- Why us -->
  {whyUs && (
    <section class="section bg-navy-mist" aria-labelledby="why-heading">
      <div class="container-site">
        <div class="reveal">
          <p class="kicker">Why Uncle Joe's</p>
          <h2 id="why-heading" class="heading-lg">{whyUs.heading}</h2>
        </div>
        <ul class="reveal mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
          {whyUs.items.map((item, i) => (
            <li class="border-t-4 border-navy pt-5">
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-shutter font-display text-sm font-bold text-navy">0{i + 1}</span>
              <h3 class="mt-3 text-2xl">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-ink-soft">{item.text}</p>
            </li>
          ))}
        </ul>
        <div class="reveal mt-10"><Credentials /></div>
      </div>
    </section>
  )}

  <Gallery />

  <MeetOwner />

  <!-- Story teaser -->
  {storyTeaser && (
    <section class="on-dark bg-shingles" data-motion aria-labelledby="story-heading">
      <div class="container-site grid items-center gap-10 py-16 sm:py-20 lg:grid-cols-[minmax(0,24rem)_1fr] lg:gap-16 lg:py-24">
        {shutters && (
          <div class="reveal relative mx-auto w-full max-w-xs lg:max-w-none">
            <span aria-hidden="true" class="absolute -right-3 -bottom-3 h-full w-full rounded-2xl bg-shutter"></span>
            <Image src={shutters} alt="A yellow wooden shutter with a white anchor cut into it" widths={[400, 800]} sizes="(min-width: 1024px) 384px, 320px" class="relative aspect-[4/5] w-full rounded-2xl border-2 border-white/20 object-cover" loading="lazy" />
          </div>
        )}
        <div class="reveal max-w-2xl">
          <p class="kicker">Our story</p>
          <h2 id="story-heading" class="heading-lg">{storyTeaser.heading}</h2>
          <p class="mt-4 text-lg leading-relaxed">{storyTeaser.text}</p>
          <a href="/our-story/" class="btn btn-outline-light mt-6">Read our story <Icon name="arrow" class="h-4 w-4" /></a>
        </div>
      </div>
    </section>
  )}

  <!-- Guides -->
  <section class="section" aria-labelledby="guides-heading">
    <div class="container-site">
      <div class="reveal">
        <p class="kicker">Plain talk</p>
        <h2 id="guides-heading" class="heading-lg">Know what you're buying</h2>
        <p class="mt-3 max-w-2xl text-lg text-ink-soft">Two short guides that answer the questions people are usually too polite to ask a roofer.</p>
      </div>
      <div class="reveal mt-8"><GuideCards /></div>
    </div>
  </section>

  <!-- Service area -->
  {serviceArea && (
    <section class="section border-t border-line bg-paper" aria-labelledby="area-heading">
      <div class="container-site">
        <div class="reveal">
          <p class="kicker">Service area</p>
          <h2 id="area-heading" class="heading-lg">{serviceArea.heading}</h2>
          <p class="mt-3 max-w-2xl text-lg text-ink-soft">{serviceArea.text}</p>
        </div>
        <div class="reveal mt-8"><TownGrid /></div>
        <a href="/service-areas/" class="link mt-6 inline-flex items-center gap-1.5">All service areas <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
    </section>
  )}

  <Reviews heading={reviews?.heading} text={reviews?.text} />

  <CtaBand heading={finalCta?.heading} text={finalCta?.text} location="home_final_cta" />
</Layout>
