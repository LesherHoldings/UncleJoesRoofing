---
/**
 * Google Ads landing page. noindex,nofollow; excluded from the sitemap (astro.config.mjs).
 * Layout variant "landing": logo + phone header, slim footer, the usual sticky mobile call bar.
 * Copy: src/content/pages/lp-roof-replacement.md. "What's included", the 4 steps and most FAQs are
 * reused from src/content/services/roof-replacement.md. Seasonal copy: src/config/site.ts → offer.
 */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CallButton from '../../components/CallButton.astro';
import Checklist from '../../components/Checklist.astro';
import Steps from '../../components/Steps.astro';
import GhlForm from '../../components/GhlForm.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { site, offer, owner, bookHref } from '../../config/site';
import { photo } from '../../lib/photos';

const page = (await getEntry('pages', 'lp-roof-replacement'))!;
const d = page.data;
const lp = d.lp!;
const replacement = (await getEntry('services', 'roof-replacement'))!;
const hero = photo(d.image);
const ownerImg = photo(owner.photo);

const h1 = offer.enabled ? offer.headline : offer.offHeadline;
const sub = `${offer.enabled ? offer.deadlineText + ' ' : ''}${lp.subheading}`;
const reused = lp.faqFrom.map((q) => replacement.data.faqs.find((f) => f.q === q)).filter((f): f is { q: string; a: string } => Boolean(f));
const faqs = [...reused, ...d.faqs];
---
<Layout title={d.title} description={d.description} ogImage={d.ogImage} robots="noindex, nofollow" variant="landing" faqs={faqs}>
  <!-- 1. Hero + form (form beside the hero on desktop, directly under it on mobile) -->
  <section class="on-dark bg-glow relative isolate overflow-hidden bg-navy" data-motion>
    {hero && <Image src={hero} alt={d.imageAlt ?? ''} widths={[640, 960, 1280, 1920]} sizes="100vw" class="absolute inset-0 -z-20 h-full w-full object-cover" loading="eager" fetchpriority="high" />}
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-deep via-navy/90 to-navy/50" aria-hidden="true"></div>
    <div class="container-site grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[1.1fr_minmax(0,26rem)] lg:py-20">
      <div>
        <p class="kicker">Roof replacement · Montgomery County, PA</p>
        <h1 class="heading-xl text-white">{h1}</h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed sm:text-xl">{sub}</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <CallButton location="lp_hero" variant="yellow-dark" class="text-lg" />
          <a href={bookHref} class="btn btn-outline-light text-lg">Book a Free Inspection</a>
        </div>
      </div>
      <div id="quote" class="scroll-mt-20">
        <GhlForm heading="Get my free quote" text="Tell us about your roof. We'll call you to set up the free inspection." />
      </div>
    </div>
  </section>

  <!-- 2. Trust strip -->
  <div class="border-b border-line bg-white">
    <ul class="container-site flex flex-wrap items-center justify-center gap-x-6 gap-y-2 py-4 text-sm font-semibold text-navy">
      {lp.trust.map((t) => <li class="flex items-center gap-2"><Icon name="check" class="h-5 w-5 text-shutter-dark" />{t}</li>)}
    </ul>
  </div>

  <!-- 3. What's included (same list as /roof-replacement/) -->
  <section class="section">
    <div class="container-site">
      <div class="rounded-xl border-2 border-navy bg-white p-6 shadow-sign sm:p-8">
        <p class="kicker">Included</p>
        <h2 class="text-2xl sm:text-3xl">What's included in every Uncle Joe's roof</h2>
        <Checklist items={replacement.data.highlights} class="mt-5 sm:columns-2 sm:gap-8 [&>li]:break-inside-avoid" />
      </div>
    </div>
  </section>

  <!-- 4. Owner -->
  <section class="bg-navy-mist py-12 sm:py-16">
    <div class="container-site grid items-center gap-8 sm:grid-cols-[12rem_1fr] lg:grid-cols-[16rem_1fr]">
      {ownerImg ? (
        <Image src={ownerImg} alt={owner.photoAlt} widths={[320, 640]} sizes="(min-width: 1024px) 256px, 192px" class="mx-auto aspect-[4/5] w-48 rounded-2xl border-2 border-navy object-cover lg:w-64" loading="lazy" />
      ) : (
        <div class="mx-auto flex aspect-[4/5] w-48 items-center justify-center rounded-2xl border-2 border-navy bg-navy text-shutter" aria-hidden="true"><Icon name="anchor" class="h-12 w-12" /></div>
      )}
      <div>
        <p class="kicker">From the owner</p>
        <p class="text-xl leading-relaxed text-navy">{lp.ownerText}</p>
        <p class="mt-3 font-display text-xl font-bold text-navy">— {owner.name}, {owner.role}</p>
        <a href="/our-story/" class="link mt-2 inline-block" target="_blank" rel="noopener">Read our story <span class="sr-only">(opens in a new tab)</span></a>
      </div>
    </div>
  </section>

  <!-- 5. Spring fallback (only while the seasonal offer is on) -->
  {offer.enabled && (
    <section class="border-y border-line bg-white">
      <div class="container-site flex flex-col gap-5 border-l-8 border-shutter py-6 pl-5 sm:pl-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="text-2xl">{offer.fallbackHeading}</h2>
          <p class="mt-1 text-lg text-ink-soft">{offer.fallbackText}</p>
        </div>
        <a href={bookHref} class="btn btn-primary lg:flex-none">Book a Free Inspection</a>
      </div>
    </section>
  )}

  <!-- 6. Four steps (same as /roof-replacement/) -->
  <section class="section">
    <div class="container-site">
      <p class="kicker">How it works</p>
      <h2 class="heading-lg">Four steps, no runaround</h2>
      <Steps steps={replacement.data.steps} class="mt-8" />
    </div>
  </section>

  <!-- 7. FAQ -->
  <Faq faqs={faqs} heading="Quick answers" />

  <!-- 8. Final CTA -->
  <CtaBand heading="Need a roof done right? Call your uncle." text={offer.enabled ? `${offer.headline} ${offer.deadlineText}` : 'Book a free roof inspection, or just call and ask.'} location="lp_final" />
</Layout>
