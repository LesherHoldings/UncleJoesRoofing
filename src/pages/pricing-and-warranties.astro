---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import GhlForm from '../components/GhlForm.astro';
import GuideCards from '../components/GuideCards.astro';
import Icon from '../components/Icon.astro';
import { site, bookHref, isPlaceholder } from '../config/site';
const showWarranty = !isPlaceholder(site.warranty);
const partner = isPlaceholder(site.financing.partner) ? '' : site.financing.partner;

const page = (await getEntry('pages', 'pricing-and-warranties'))!;
const { Content } = await render(page);
const d = page.data;
const crumbs = [{ name: 'Pricing & Warranties', path: '/pricing-and-warranties/' }];
---
<Layout title={d.title} description={d.description} ogImage={d.ogImage} breadcrumbs={crumbs} faqs={d.faqs}>
  <PageHero h1={d.h1} intro={d.intro} kicker="Plain talk" breadcrumbs={crumbs} image={d.image} imageAlt={d.imageAlt} requestLink location="pricing_hero" />
  <section class="section">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_minmax(0,24rem)]">
      <div>
        <div class="prose prose-lg prose-site max-w-none">
          <Content />
        </div>
        <div class:list={['mt-10 grid gap-5', showWarranty && 'sm:grid-cols-2']}>
          {showWarranty && (
            <div class="rounded-xl border-2 border-navy bg-white p-6 shadow-sign">
              <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-navy text-shutter"><Icon name="shield" class="h-5 w-5" /></span>
              <h2 class="mt-3 text-2xl">Our warranty terms</h2>
              <p class="mt-2 text-ink-soft">{site.warranty}</p>
            </div>
          )}
          <div class="rounded-xl border-2 border-line bg-navy-mist p-6">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-navy text-shutter"><Icon name="dollar" class="h-5 w-5" /></span>
            <h2 class="mt-3 text-2xl">Financing</h2>
            <p class="mt-2 text-ink-soft">{partner ? `Available through ${partner}. ` : 'Available through our financing partner. '}Subject to credit approval; rates and terms are set by the lender.</p>
            <a href="/financing/" class="link mt-3 inline-block">How financing works</a>
          </div>
        </div>
      </div>
      <aside id="request" class="scroll-mt-24 lg:sticky lg:top-28 lg:self-start">
        <a href={bookHref} class="btn btn-primary mb-6 w-full text-lg">Get a free quote</a>
        <GhlForm heading="Or request a call back" text="Tell us a little about your roof and we'll call you to set a time." />
      </aside>
    </div>
  </section>
  <Faq faqs={d.faqs} heading="Pricing and warranty questions" />
  <section class="section border-t border-line bg-paper">
    <div class="container-site">
      <h2 class="heading-lg">Next, read</h2>
      <div class="mt-8"><GuideCards exclude="pricing" /></div>
    </div>
  </section>
  <CtaBand location="pricing_cta" />
</Layout>
