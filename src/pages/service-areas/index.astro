---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import TownGrid from '../../components/TownGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import CallButton from '../../components/CallButton.astro';
import { nearbyTowns } from '../../config/site';

const page = (await getEntry('pages', 'service-areas'))!;
const d = page.data;
const crumbs = [{ name: 'Service Areas', path: '/service-areas/' }];
---
<Layout title={d.title} description={d.description} ogImage={d.ogImage} breadcrumbs={crumbs} pageType="CollectionPage">
  <PageHero h1={d.h1} intro={d.intro} kicker="Where we work" breadcrumbs={crumbs} image={d.image} imageAlt={d.imageAlt} location="service_areas_hero" />
  <section class="section">
    <div class="container-site">
      <p class="kicker">Towns</p>
      <h2 class="heading-lg">Towns with their own page</h2>
      <div class="mt-8"><TownGrid /></div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <div class="rounded-xl border-2 border-line p-6">
          <h2 class="text-2xl">Nearby towns we also serve</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {nearbyTowns.map((t) => <li class="tag">{t}, PA</li>)}
          </ul>
        </div>
        <div class="rounded-xl border-2 border-line bg-navy-mist p-6">
          <h2 class="text-2xl">Not on the list?</h2>
          <p class="mt-2 text-ink-soft">
            If you're in Montgomery or Chester County and don't see your town, call and ask. We'll tell you honestly whether we can do a good job for you.
          </p>
          <CallButton location="service_areas_not_listed" variant="dark" class="mt-4" />
        </div>
      </div>
    </div>
  </section>
  <CtaBand location="service_areas_cta" />
</Layout>
